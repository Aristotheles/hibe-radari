FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY hibe ./hibe
COPY config ./config
RUN mkdir -p /app/data/aggregator && useradd --uid 10001 --no-create-home worker && chown -R worker:worker /app/data
USER worker
CMD ["python", "-m", "hibe.cloud_refresh"]
